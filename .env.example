# Copy to .env (git-ignored). On Vercel, add the same names under Settings > Environment Variables.

# Required. Create one at https://resend.com/api-keys
RESEND_API_KEY=

# Optional. Where contact form messages are delivered. Defaults to contact.email in utils/data.js
# CONTACT_TO_EMAIL=

# Optional. The sender. Resend's onboarding address only delivers to the email that owns the
# Resend account; to send from your own address, verify a domain in Resend first.
# CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
